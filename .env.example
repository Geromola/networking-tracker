# Copy to .env.local and fill in the real values. .env.local is gitignored.
#
# Where each value comes from: Neon Console -> your project.
#   Auth URL      -> the "Auth" tab, after enabling Managed Better Auth
#   Data API URL  -> the "Data API" tab, after enabling the Data API
#   DATABASE_URL  -> the project Dashboard "Connection string"

# ---------------------------------------------------------------------------
# Server-only. Never prefixed with VITE_, so Vite cannot bundle them into the
# browser build even by accident.
# ---------------------------------------------------------------------------

NEON_AUTH_URL=https://ep-example-123456.neonauth.us-east-2.aws.neon.tech/neondb/auth
NEON_DATA_API_URL=https://ep-example-123456.apirest.us-east-2.aws.neon.tech/neondb/rest/v1

# Optional. Defaults to $NEON_AUTH_URL/.well-known/jwks.json — set it only if
# your Neon project publishes its public keys somewhere else.
# NEON_AUTH_JWKS_URL=

# Used ONLY by a human, pasting db/schema.sql into the Neon SQL Editor.
# The running application never reads this, and it is not set in Vercel.
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# ---------------------------------------------------------------------------
# Public. Vite inlines VITE_-prefixed values into the browser bundle, so only
# put things here that are safe for anyone to read.
#
# The assignment lists this as NEXT_PUBLIC_NEON_AUTH_URL. This project is a
# Vite SPA rather than Next.js, and Vite only exposes VITE_-prefixed variables
# to the browser, so the name differs while the value is the same.
# ---------------------------------------------------------------------------

VITE_NEON_AUTH_URL=https://ep-example-123456.neonauth.us-east-2.aws.neon.tech/neondb/auth

# There is deliberately no public Data API URL. The browser never calls the
# Data API directly; it goes through this project's own backend. See the
# "Security" section of the README.

# ---------------------------------------------------------------------------
# Optional: credentials for the two-user RLS test (npm test). Without these the
# ownership tests skip, so a fresh clone still gets a green suite.
# Create both accounts through the app's own sign-up form.
# ---------------------------------------------------------------------------

# TEST_USER_A_EMAIL=
# TEST_USER_A_PASSWORD=
# TEST_USER_B_EMAIL=
# TEST_USER_B_PASSWORD=
